LUNIT_FM_API_URL=https://model.hackathon.lunit.io
LUNIT_FM_API_KEY=replace-with-runtime-secret
LUNIT_FM_MODEL=Lunit/L2-preview
LUNIT_MCP_URL=https://mcp.hackathon.lunit.io/mcp

# Optional bounded-orchestration settings
LUNIT_MODEL_TIMEOUT_SECONDS=120
LUNIT_MCP_TIMEOUT_SECONDS=60
LUNIT_REQUEST_TIMEOUT_SECONDS=240
LUNIT_GENERATION_CALL_LIMIT=3
LUNIT_RETRIEVAL_INVOCATION_LIMIT=1
LUNIT_RETRIEVAL_TURN_LIMIT=4
LUNIT_RETRIEVAL_EVIDENCE_ROUND_LIMIT=1
LUNIT_RETRIEVAL_NO_PROGRESS_LIMIT=3
LUNIT_RETRIEVAL_TOOL_LIMIT=8
LUNIT_RETRIEVAL_INPUT_CHAR_LIMIT=80000
LUNIT_MCP_TOOL_CALL_LIMIT=4
LUNIT_SELECTED_SOURCE_LIMIT=4
LUNIT_SOURCE_TOKEN_LIMIT=800
LUNIT_AUGMENTATION_TOKEN_LIMIT=3000
LUNIT_MODEL_MAX_TOKENS=1024
LUNIT_RETRIEVAL_MODEL_MAX_TOKENS=512
LUNIT_REPAIR_MODEL_MAX_TOKENS=768
LUNIT_MCP_RESULT_CHAR_LIMIT=6000

# Docker uses the bundled Team B prompts below by default. Override only for experiments.
# LUNIT_GENERATION_PROMPT_PATH=prompts/generation/production_tool_v3.md
# LUNIT_RETRIEVAL_PROMPT_PATH=prompts/retrieval/grounded_v1.md
